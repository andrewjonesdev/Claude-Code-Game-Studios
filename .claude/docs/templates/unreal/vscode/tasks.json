{
  // Builds run hidden with node reuse off (fleet headless-console rule).
  "version": "2.0.0",
  "options": { "env": { "MSBUILDDISABLENODEREUSE": "1", "DOTNET_NOLOGO": "1", "DOTNET_CLI_TELEMETRY_OPTOUT": "1" } },
  "tasks": [
    {
      "label": "UE: Build editor (Development)",
      "type": "process",
      "command": "<UE_ROOT>/Engine/Build/BatchFiles/Build.bat",
      "args": ["<Project>Editor", "Win64", "Development", "-Project=${workspaceFolder}/<Project>.uproject", "-WaitMutex"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "UE: Generate clang database",
      "type": "process",
      "command": "<UE_ROOT>/Engine/Build/BatchFiles/RunUBT.bat",
      "args": ["-mode=GenerateClangDatabase", "-project=${workspaceFolder}/<Project>.uproject", "<Project>Editor", "Win64", "Development", "-OutputDir=${workspaceFolder}"],
      "problemMatcher": []
    },
    {
      "label": "UnrealSharp: Build managed",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/<ScriptDirName>/<ManagedProjectName>.sln", "-c", "Debug"],
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
