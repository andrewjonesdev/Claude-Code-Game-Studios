{
  // Fill <ScriptDirName>/<ManagedProjectName> from the project's UnrealSharp settings.
  "dotrush.roslyn.projectOrSolutionFiles": [
    "${workspaceFolder}/<ScriptDirName>/<ManagedProjectName>.sln"
  ],
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--header-insertion=never",
    "--background-index"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "files.exclude": {
    "**/Binaries": true,
    "**/Intermediate": true,
    "**/DerivedDataCache": true,
    "**/Saved": true
  },
  "search.exclude": {
    "**/Binaries": true,
    "**/Intermediate": true,
    "**/DerivedDataCache": true,
    "**/Saved": true,
    "**/Content": true
  },
  // Never let the IDE touch binary assets.
  "files.readonlyInclude": { "**/*.uasset": true, "**/*.umap": true }
}
